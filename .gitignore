# AI assistant context (.kiro/) is TRACKED in the private/hub repos and is
# stripped from PUBLIC releases by scripts/release-to-public.sh
# (`git reset HEAD -- .kiro/`), NOT by this gitignore. Do NOT re-add a
# wholesale `.kiro/` ignore — that would un-track specs/memory/steering and
# defeat the release-script exclusion. Only ephemeral/per-PID artifacts under
# .kiro/ are ignored (see "Kiro session artifacts" below).

# Unraid docs mirror (large, not needed for plugin)
unraid-docs-official/

# Screenshots (development only)
screenshots/

# Test harness temp files
cleanup-harness.sh

# Kiro session artifacts (per-PID, ephemeral)
.kiro/.compaction-canary.*
.kiro/.prompt-counter
.kiro/.prompt-counter.*
.kiro/.steering-timestamps.*
.kiro/.orch-awareness.*
.kiro/.workstream-seen.*
.kiro/.mailbox-seen.*
.kiro/.spec-injection-cache.*
.kiro/.structure-injection-cache.*
.kiro/.skill-rec-state.*
.kiro/cache/
.kiro/00-memory/.lock.*
.kiro/00-memory/.certificate-data.*
.kiro/00-memory/.operating-mode.*
.kiro/00-memory/workstreams/.lock.*
.kiro/think_gate_scope_cache.*
.kiro/think_gate_triage_cache.*
.kiro/health-scores.jsonl
.vite/
